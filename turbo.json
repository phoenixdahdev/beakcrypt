{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NODE_ENV",
        "SITE_URL",
        "CONVEX_URL",
        "BETTER_AUTH_URL",
        "CONVEX_SITE_URL",
        "GITHUB_CLIENT_ID",
        "CONVEX_DEPLOYMENT",
        "CONVEX_DEPLOY_KEY",
        "BETTER_AUTH_SECRET",
        "SKIP_ENV_VALIDATION",
        "GITHUB_CLIENT_SECRET"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}