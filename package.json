{
  "name": "beakcrypt",
  "private": true,
  "scripts": {
    "lint": "turbo run lint",
    "build": "turbo run build",
    "dev": "turbo dev --ui tui",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "dev:docs": "turbo dev --filter=@beakcrypt/docs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build:cli": "turbo run build --filter=beakcrypt",
    "dev:convex": "turbo dev --filter=@beakcrypt/convex",
    "build:app": "turbo run build --filter=@beakcrypt/web",
    "build:docs": "turbo run build --filter=@beakcrypt/docs",
    "dev:cli": "turbo dev --filter=beakcrypt --filter=@beakcrypt/convex",
    "dev:app": "turbo dev --filter=@beakcrypt/web --filter=@beakcrypt/convex",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@beakcrypt/eslint-config": "workspace:*",
    "@beakcrypt/typescript-config": "workspace:*",
    "@changesets/cli": "^2.29.8",
    "@typescript/native-preview": "7.0.0-dev.20260301.1",
    "prettier": "^3.8.1",
    "turbo": "^2.8.13"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "patchedDependencies": {
      "@convex-dev/better-auth": "patches/@convex-dev__better-auth.patch",
      "@better-auth/passkey@1.4.9": "patches/@better-auth__passkey@1.4.9.patch"
    }
  }
}
