{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "beakcrypt-web": {
      "packageName": "@beakcrypt/web",
      "development": {
        "local": 3000,
        "fallback": "beakcrypt.com"
      }
    },
    
    "beakcrypt-docs": {
      "packageName": "@beakcrypt/docs",
      "development": {
        "local": 3001
      },
      "routing": [
        {
          "paths": [
            "/docs",
            "/docs/:path*"
          ]
        }
      ]
    }
  }
}