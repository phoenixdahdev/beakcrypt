    "@beakcrypt/ui": "workspace:*",
    "@convex-dev/better-auth": "^0.10.13",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@vercel/analytics": "^1.6.1",
    "@vercel/microfrontends": "^2.3.1",
    "better-auth": "1.5.0",
    "convex": "^1.32.0",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@beakcrypt/eslint-config": "workspace:*",
    "@beakcrypt/typescript-config": "workspace:*",
